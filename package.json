{
  "name": "carro-em-dia",
  "version": "1.5.4",
  "private": true,
  "description": "Controle de manutencao de veiculos: historico, lembretes e gastos.",
  "main": "expo-router/entry",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:expo": "npx expo-doctor",
    "start": "node scripts/doctor.mjs --preflight && expo start",
    "start:tunnel": "node scripts/doctor.mjs --preflight && expo start --tunnel",
    "start:limpo": "node scripts/doctor.mjs --preflight && expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test --import tsx src/__tests__/*.test.ts",
    "test:watch": "node --test --watch --import tsx src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "fix:deps": "npx expo install --fix",
    "verify": "npm run typecheck && npm run lint && npm test",
    "tokens": "tsx scripts/export-tokens.ts",
    "versoes": "bash scripts/publicar-versoes.sh",
    "assinar": "bash scripts/assinar-commits.sh",
    "setup:fixo": "node scripts/setup.mjs --fixo",
    "sdk:atualizar": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.9",
    "expo-asset": "~11.1.5",
    "expo-constants": "~17.1.6",
    "expo-haptics": "~14.1.4",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.5",
    "expo-notifications": "~0.31.2",
    "expo-router": "~5.0.7",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
