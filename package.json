{
  "name": "carro-em-dia",
  "version": "1.7.0",
  "private": true,
  "description": "Controle de manutencao de veiculos: historico, lembretes e gastos.",
  "main": "expo-router/entry",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:expo": "npx expo-doctor",
    "start": "node scripts/doctor.mjs --preflight && expo start",
    "start:tunnel": "node scripts/doctor.mjs --preflight && expo start --tunnel",
    "start:limpo": "node scripts/doctor.mjs --preflight && expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test --import tsx src/__tests__/*.test.ts",
    "test:watch": "node --test --watch --import tsx src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "fix:deps": "npx expo install --fix",
    "verify": "npm run typecheck && npm run lint && npm test",
    "tokens": "tsx scripts/export-tokens.ts",
    "versoes": "bash scripts/publicar-versoes.sh",
    "assinar": "bash scripts/assinar-commits.sh",
    "setup:fixo": "node scripts/setup.mjs",
    "sdk:atualizar": "node scripts/setup.mjs --atualizar-sdk"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
