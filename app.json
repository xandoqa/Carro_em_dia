{
  "expo": {
    "name": "CarroEmDia",
    "slug": "carro-em-dia",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "carroemdia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F4D45"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.ucb.carroemdia",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "O app usa suas fotos para anexar a imagem do veiculo e a nota fiscal do servico.",
        "NSCameraUsageDescription": "O app usa a camera para fotografar a nota fiscal do servico."
      }
    },
    "android": {
      "package": "br.ucb.carroemdia",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F4D45"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["READ_MEDIA_IMAGES", "CAMERA", "POST_NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0F4D45",
          "defaultChannel": "manutencao"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app usa suas fotos para anexar a imagem do veiculo e a nota fiscal do servico.",
          "cameraPermission": "O app usa a camera para fotografar a nota fiscal do servico."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
